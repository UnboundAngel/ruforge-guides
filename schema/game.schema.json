{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruforge.app/guides/schema/game.schema.json",
  "title": "RuForge game guide",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "sections"],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "steamAppId": { "type": "integer", "minimum": 1 },
    "msStoreId": { "type": "string", "pattern": "^[0-9A-Z]{12}$" },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 100 },
      "uniqueItems": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "resources"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 48 },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/resource" }
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "name", "line", "open"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 2048
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "line": { "type": "string", "minLength": 1, "maxLength": 160 },
        "open": { "enum": ["glance", "browser"] },
        "credit": { "type": "string", "minLength": 1, "maxLength": 48 }
      }
    }
  }
}
